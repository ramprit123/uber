<?xml version="1.0" encoding="UTF-8"?>
<svg width="800" height="600" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="wheelGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#333333;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#666666;stop-opacity:1" />
    </linearGradient>
  </defs>
  <circle cx="400" cy="300" r="250" fill="url(#wheelGradient)" />
  <circle cx="400" cy="300" r="200" fill="none" stroke="#888888" stroke-width="10" />
  <circle cx="400" cy="300" r="150" fill="none" stroke="#888888" stroke-width="8" />
  <circle cx="400" cy="300" r="100" fill="none" stroke="#888888" stroke-width="6" />
  <circle cx="400" cy="300" r="50" fill="none" stroke="#888888" stroke-width="4" />
  <!-- Spokes -->
  <g stroke="#888888" stroke-width="15">
    <line x1="400" y1="50" x2="400" y2="550" />
    <line x1="150" y1="300" x2="650" y2="300" />
    <line x1="228" y1="128" x2="572" y2="472" />
    <line x1="228" y1="472" x2="572" y2="128" />
  </g>
</svg>